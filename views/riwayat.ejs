<%- include('partials/header') %>

<div class="container my-4">
    <h2 class="fw-bold text-dark mb-3">📦 Riwayat Pemesanan Saya</h2>
    <p class="text-muted">Halo, <strong><%= customerName %></strong>. Berikut adalah daftar kamar yang pernah Anda pesan.</p>
    <hr>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Kamar</th>
                            <th>Harga</th>
                            <th>Check-In / Out</th>
                            <th>Kontak</th>
                            <th>Status Pesanan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (reservasi && reservasi.length > 0) { %>
                            <% reservasi.forEach((r, index) => { %>
                                <tr>
                                    <td class="fw-bold"><%= index + 1 %></td>
                                    <td class="fw-semibold text-primary"><%= r.nama_kamar %></td>
                                    <td class="text-success fw-bold">Rp <%= Number(r.harga).toLocaleString('id-ID') %></td>
                                    <td>
                                        <small><strong>In:</strong> <%= r.tanggal_checkin.toISOString().split('T')[0] %></small><br>
                                        <small><strong>Out:</strong> <%= r.tanggal_checkout.toISOString().split('T')[0] %></small>
                                    </td>
                                    <td><%= r.telepon %></td>
                                    <td>
                                        <% 
                                            let badgeColor = 'warning text-dark';
                                            if (r.status === 'Dikonfirmasi') badgeColor = 'success';
                                            else if (r.status === 'Dibatalkan') badgeColor = 'danger';
                                        %>
                                        <span class="badge bg-<%= badgeColor %>"><%= r.status %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Anda belum memiliki riwayat pemesanan kamar. Silakan pesan kamar di beranda!
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <a href="/" class="btn btn-secondary">← Kembali ke Beranda</a>
    </div>
</div>

<%- include('partials/footer') %>