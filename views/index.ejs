<%- include('partials/header') %>

    <style>
        html {
            scroll-behavior: smooth;
        }

        .hero-section {
            background: linear-gradient(rgba(15, 23, 42, 0.132), rgba(15, 23, 42, 0.283)),
                url('/images/hero-hotel.webp') center/cover no-repeat;
            border-radius: 20px;
            padding: 5rem 2rem;
            color: #ffffff;
        }

        @media (max-width: 768px) {
            .hero-section {
                padding: 3rem 1rem !important;
                border-radius: 12px;
                margin-left: 10px;
                margin-right: 10px;
            }

            .hero-section h1 {
                font-size: 1.8rem !important;
                /* Ukuran judul disesuaikan agar pas di layar HP */
            }

            .hero-section p {
                font-size: 0.9rem !important;
            }

            .room-img {
                height: 180px !important;
                /* Gambar kamar sedikit lebih ringkas di HP */
            }
        }

        .feature-card {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            background: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
        }

        .room-card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .room-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
        }

        .room-img {
            height: 210px;
            object-fit: cover;
            width: 100%;
        }
    </style>

    <!-- 1. HERO SECTION -->
    <section class="hero-section text-center shadow-sm mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-semibold mb-3">
                    ✨ Kenyamanan & Keamanan Menginap Terbaik
                </span>
                <h1 class="display-5 fw-bold mb-3">Selamat Datang di Hotel AYONG</h1>
                <p class="lead text-light opacity-75 mb-4">
                    Nikmati pengalaman istirahat yang tenang dengan fasilitas modern, pelayanan ramah 24 jam, dan proses
                    pemesanan kamar yang cepat serta aman.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="#daftar-kamar" class="btn btn-light btn-lg fw-bold px-4 rounded-3">
                        🛏️ Lihat Pilihan Kamar
                    </a>
                    <% if (typeof customer !=='undefined' && customer) { %>
                        <a href="/riwayat" class="btn btn-outline-light btn-lg px-4 rounded-3">
                            📦 Cek Pesanan Saya
                        </a>
                        <% } else if (typeof isAdmin==='undefined' || !isAdmin) { %>
                            <a href="/register" class="btn btn-outline-light btn-lg px-4 rounded-3">
                                Daftar Akun Tamu
                            </a>
                            <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. FASILITAS & KEUNGGULAN HOTEL -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Mengapa Memilih Hotel AYONG?</h3>
            <p class="text-muted small">Standar pelayanan terbaik untuk kenyamanan perjalanan bisnis maupun liburan Anda
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card p-4 h-100 text-center">
                    <div class="fs-2 mb-2">⚡</div>
                    <h5 class="fw-bold text-dark">Booking Instan & Aman</h5>
                    <p class="text-muted small mb-0">
                        Reservasi kamar langsung dari perangkat Anda dengan sistem perlindungan data akun terenkripsi.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card p-4 h-100 text-center">
                    <div class="fs-2 mb-2">📶</div>
                    <h5 class="fw-bold text-dark">Wi-Fi & Fasilitas Lengkap</h5>
                    <p class="text-muted small mb-0">
                        Setiap kamar dilengkapi akses internet berkecepatan tinggi, AC, dan perlengkapan mandi modern.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card p-4 h-100 text-center">
                    <div class="fs-2 mb-2">🛎️</div>
                    <h5 class="fw-bold text-dark">Layanan Resepsionis 24 Jam</h5>
                    <p class="text-muted small mb-0">
                        Tim kami siap membantu proses check-in, check-out, maupun kebutuhan kamar Anda kapan saja.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. KATALOG PILIHAN KAMAR -->
    <section id="daftar-kamar" class="pt-2 mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Pilihan Kamar Kami</h3>
                <p class="text-muted small mb-0">Pilih kamar yang sesuai dengan kebutuhan menginap Anda</p>
            </div>
        </div>

        <div class="row g-4">
            <% if (typeof kamar !=='undefined' && kamar.length> 0) { %>
                <% kamar.forEach(k=> { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card room-card shadow-sm h-100 bg-white">
                            <div class="position-relative">
                                <img src="/uploads/<%= k.foto %>" alt="<%= k.nama_kamar %>" class="room-img"
                                    onerror="this.src='https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=800&q=80'">
                                <span
                                    class="badge position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill <%= k.status === 'Tersedia' ? 'bg-success' : 'bg-danger' %>">
                                    <%= k.status %>
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="fw-bold text-dark mb-1">
                                    <%= k.nama_kamar %>
                                </h5>
                                <p class="text-primary fw-bold mb-2">
                                    Rp <%= Number(k.harga).toLocaleString('id-ID') %>
                                        <span class="text-muted fw-normal small">/ malam</span>
                                </p>
                                <p class="text-muted small flex-grow-1 mb-4">
                                    <%= k.deskripsi || 'Kamar nyaman dengan fasilitas lengkap untuk istirahat Anda.' %>
                                </p>

                                <% if (k.status==='Tersedia' ) { %>
                                    <!-- Sesuaikan href di bawah jika rute booking Anda bernama /booking/<%= k.id %> -->
                                    <a href="/pesan/<%= k.id %>" class="btn btn-dark w-100 fw-semibold rounded-3 py-2">
                                        Pesan Kamar Ini
                                    </a>
                                    <% } else { %>
                                        <button class="btn btn-secondary w-100 rounded-3 py-2" disabled>
                                            Kamar Penuh
                                        </button>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="col-12">
                                <div class="alert alert-light border text-center py-5 rounded-4">
                                    <p class="text-muted mb-0">Belum ada data kamar yang tersedia saat ini.</p>
                                </div>
                            </div>
                            <% } %>
        </div>
    </section>

    <!-- 4. CTA / INFORMASI SINGKAT BAWAH -->
    <section class="bg-white border rounded-4 p-4 p-md-5 text-center shadow-sm">
        <h4 class="fw-bold text-dark mb-2">Siap Merencanakan Kunjungan Anda?</h4>
        <p class="text-muted small mb-4">
            Buat akun pelanggan dalam hitungan detik untuk memesan kamar dan memantau riwayat reservasi Anda secara
            real-time.
        </p>
        <a href="#daftar-kamar" class="btn btn-outline-dark fw-semibold px-4 rounded-3">
            Mulai Pilih Kamar ↑
        </a>
    </section>

    <%- include('partials/footer') %>