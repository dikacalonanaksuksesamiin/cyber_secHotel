<%- include('partials/header') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Dashboard Admin Hotel</h2>
            <p class="text-muted mb-0">Selamat datang kembali, <strong>
                    <%= admin %>
                </strong>!</p>
        </div>
        <div>
            <a href="/admin/kamar/tambah" class="btn btn-success fw-semibold me-2">➕ Tambah Kamar</a>
            <a href="/admin/logout" class="btn btn-outline-danger fw-semibold">🚪 Logout</a>
        </div>
    </div>

    <!-- Tabel Manajemen Kamar (CRUD) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="fw-bold text-dark mb-3">🛏️ Manajemen Data Kamar</h4>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Foto</th>
                            <th>Nama Kamar</th>
                            <th>Harga / Malam</th>
                            <th>Status</th>
                            <th>Keterangan</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (kamar && kamar.length> 0) { %>
                            <% kamar.forEach((k, index)=> { %>
                                <tr>
                                    <td class="fw-bold">
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <% if (k.foto) { %>
                                            <img src="/uploads/<%= k.foto %>" alt="Foto"
                                                style="width: 70px; height: 50px; object-fit: cover;"
                                                class="rounded border">
                                            <% } else { %>
                                                <span class="text-muted small">No Image</span>
                                                <% } %>
                                    </td>
                                    <td class="fw-semibold">
                                        <%= k.nama_kamar %>
                                    </td>
                                    <td class="text-success fw-bold">Rp <%= Number(k.harga).toLocaleString('id-ID') %>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= k.status === 'Tersedia' ? 'success' : 'danger' %>">
                                            <%= k.status %>
                                        </span>
                                    </td>
                                    <td class="text-muted">
                                        <%= k.keterangan || '-' %>
                                    </td>
                                    <td class="text-center">
                                        <a href="/admin/kamar/edit/<%= k.id %>"
                                            class="btn btn-warning btn-sm fw-semibold px-2 me-1">✏️ Edit</a>
                                        <a href="/admin/kamar/hapus/<%= k.id %>"
                                            class="btn btn-danger btn-sm fw-semibold px-2"
                                            onclick="return confirm('Yakin ingin menghapus kamar ini?')">🗑️ Hapus</a>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                Belum ada data kamar di database Supabase. Silakan klik tombol "Tambah
                                                Kamar" di atas.
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- Tabel Manajemen Pelanggan -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="fw-bold text-dark mb-3">👥 Manajemen Data Pelanggan</h4>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Nama Pelanggan</th>
                            <th>Email</th>
                            <th>Status Reset Password</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pelanggan && pelanggan.length > 0) { %>
                            <% pelanggan.forEach((p, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>

                                    <td class="fw-semibold">
                                        <%= p.nama %>
                                        <% if (p.reset_requested) { %>
                                            <span class="badge bg-danger ms-1">⚠️ Minta Reset</span>
                                        <% } %>
                                    </td>

                                    <td><%= p.email %></td>

                                    <td>
                                        <% if (p.reset_requested) { %>
                                            <span class="badge bg-danger">Menunggu Reset</span>
                                        <% } else { %>
                                            <span class="badge bg-success">Normal</span>
                                        <% } %>
                                    </td>

                                    <td class="text-center">
                                        <% if (p.reset_requested) { %>
                                            <form action="/admin/pelanggan/reset-password/<%= p.id %>"
                                                method="POST" class="d-inline">
                                                <input type="password"
                                                    name="password_baru"
                                                    class="form-control form-control-sm mb-2"
                                                    placeholder="Password baru"
                                                    required minlength="6">
                                                <button type="submit"
                                                    class="btn btn-warning btn-sm fw-semibold"
                                                    onclick="return confirm('Yakin ingin mereset password pelanggan ini?')">
                                                    🔑 Reset Password
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted small">Tidak ada permintaan</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Belum ada data pelanggan.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- Tabel Manajemen Reservasi / Pesanan Masuk -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="fw-bold text-dark mb-3">📋 Daftar Reservasi Masuk dari Tamu</h4>
            <!-- Tombol Ekspor Laporan -->
            <a href="/admin/reservasi/pdf" target="_blank" class="btn btn-outline-danger btn-sm fw-semibold shadow-sm">
                📄 Cetak Laporan (PDF)
            </a>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>#</th>
                            <th>Nama Pemesan</th>
                            <th>Kontak</th>
                            <th>Kamar Dipesan</th>
                            <th>Check-In / Out</th>
                            <th>Status</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (reservasi && reservasi.length> 0) { %>
                            <% reservasi.forEach((r, index)=> { %>
                                <tr>
                                    <td class="fw-bold">
                                        <%= index + 1 %>
                                    </td>
                                    <td class="fw-semibold">
                                        <%= r.nama_pemesan %>
                                            <br><small class="text-muted">
                                                <%= r.email || '-' %>
                                            </small>
                                    </td>
                                    <td>
                                        <%= r.telepon %>
                                    </td>
                                    <td class="fw-semibold text-primary">
                                        <%= r.nama_kamar %>
                                    </td>
                                    <td>
                                        <small><strong>In:</strong>
                                            <%= r.tanggal_checkin.toISOString().split('T')[0] %>
                                        </small><br>
                                        <small><strong>Out:</strong>
                                            <%= r.tanggal_checkout.toISOString().split('T')[0] %>
                                        </small>
                                    </td>
                                    <td>
                                        <% let badgeColor='warning text-dark' ; if (r.status==='Dikonfirmasi' )
                                            badgeColor='success' ; else if (r.status==='Dibatalkan' )
                                            badgeColor='danger' ; %>
                                            <span class="badge bg-<%= badgeColor %>">
                                                <%= r.status %>
                                            </span>
                                    </td>
                                    <td class="text-center">
                                        <% if (r.status==='Pending' ) { %>
                                            <a href="/admin/reservasi/status/<%= r.id %>/Dikonfirmasi"
                                                class="btn btn-success btn-sm fw-semibold px-2 me-1">✔️ Konfirmasi</a>
                                            <a href="/admin/reservasi/status/<%= r.id %>/Dibatalkan"
                                                class="btn btn-danger btn-sm fw-semibold px-2"
                                                onclick="return confirm('Yakin ingin membatalkan reservasi ini?')">❌
                                                Batalkan</a>
                                            <% } else { %>
                                                <span class="text-muted small">Selesai</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                Belum ada pesanan kamar yang masuk dari pelanggan.
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>