<%- include('partials/header') %>

    <style>
        .auth-wrapper {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #ffffff;
            border-radius: 16px;
            padding: 2rem 1rem;
        }

        .auth-box {
            width: 100%;
            max-width: 400px;
        }

        .auth-title {
            color: #0f292e;
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: -0.5px;
        }

        .auth-subtitle {
            color: #7b8794;
            font-size: 0.95rem;
        }

        .auth-label {
            color: #7b8794;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .auth-input {
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 11px 14px;
            font-size: 0.95rem;
            color: #1f2937;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .auth-input:focus {
            border-color: #3b28cc;
            box-shadow: 0 0 0 3px rgba(59, 40, 204, 0.12);
            outline: none;
        }

        .btn-auth-primary {
            background-color: #3b28cc;
            border: none;
            border-radius: 8px;
            color: #ffffff;
            font-weight: 600;
            padding: 12px;
            font-size: 0.95rem;
            transition: background-color 0.2s;
        }

        .btn-auth-primary:hover {
            background-color: #2e1fa3;
            color: #ffffff;
        }
    </style>

    <div class="auth-wrapper shadow-sm my-3">
        <div class="auth-box">
            <!-- Logo Ikon Minimalis -->
            <div class="text-center mb-3">
                <img src="/images/logo.png" alt="Logo Hotel AYONG"
                    style="width: 65px; height: 64px; object-fit: contain;">
            </div>

            <div class="text-center mb-4">
                <h1 class="auth-title mb-2">Admin Log In</h1>
                <p class="auth-subtitle mb-0">Silakan masukkan detail login Anda di bawah ini</p>
            </div>

            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger py-2 small rounded-3 mb-3" role="alert">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/admin/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label auth-label">Username</label>
                            <input type="text" name="username" class="form-control auth-input" required
                                placeholder="Masukkan username admin">
                        </div>

                        <div class="mb-4">
                            <label class="form-label auth-label">Password</label>
                            <input type="password" name="password" class="form-control auth-input" required
                                placeholder="•••••••••">
                        </div>

                        <button type="submit" class="btn btn-auth-primary w-100 mb-3">Log in</button>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/" class="text-decoration-none small text-muted">← Kembali ke Beranda</a>
                    </div>
        </div>
    </div>

    <%- include('partials/footer') %>